# Copy to .env on the stage VM and fill in. .env is gitignored; never open it on stream.
# Keep comments on their own lines (values are read verbatim).

# OBS WebSocket on the Mac, reached over Tailscale.
# OBS_HOST is the Mac's Tailscale name (or its 100.x IP).
OBS_HOST=jambos-macbook-air
OBS_PORT=4455
OBS_PASSWORD=
